function pingCompensation(releaseAxis : number, downAxis : number, oppositeChecks : boolean): number
    local ping = GetPingValue() / 1000
    local oneWay = ping / 2

    local barDuration = 0.8
    local compensationPercent = oneWay / barDuration

    local range = math.abs(releaseAxis - downAxis)
    local compensation = range * compensationPercent

    if oppositeChecks then
        return releaseAxis + compensation
    else
        return releaseAxis - compensation
    end
end

function fetchAutoAdjustValues(Meter : string): ({[string] : string | number | boolean})
    local Values = baseValues[Meter]

    if not Values then
        return nil
    end

    return {
        downAxis = Values.downAxis,
        releaseAxis = pingCompensation(Values.releaseAxis, Values.downAxis, Values.oppositeChecks or false),
        barAxis = Values.barAxis,
        oppositeChecks = Values.oppositeChecks or false
    }
end

task.spawn(function()
    while _G.autoGreenLoaded do
        local Settings = _G.Settings

        if Settings.Toggled then
            local Keybinds = Settings.Keybinds
            local Mode = Settings.Mode
            local Config = Settings.Configs[Mode]

            local isJumping = iskeypressed(tonumber(Keybinds.Jumpshot))
            local isDunking = iskeypressed(tonumber(Keybinds.Dunking))

            if (isJumping or isDunking) and not Pressing then
                local Basketball = Character:FindFirstChild("Attributes") and Character.Attributes:FindFirstChild("Basketball")
                local hasBall = Basketball and Basketball.Value ~= nil

                if hasBall then
                    local Key = isJumping and 0x45 or 0x20

                    if Mode == "Bar" then
                        Pressing = true

                        local hasStartedLow = false
                        local canRelease, shouldRelease = false, true

                        if not iskeypressed(Key) then
                            keypress(Key)
                        end
                        
                        repeat 
                            task.wait(1 / 60)

                            local ballAttr = Character:FindFirstChild("Attributes") and Character.Attributes:FindFirstChild("Basketball")
                                
                            if not (ballAttr and ballAttr.Value ~= nil) then
                                canRelease = true
                                shouldRelease = false
                                break
                            end

                            local meterOffset = Character:GetAttribute("meterOffset")
                            
                            local barAxis = Settings.barAxis
                            local oppositeChecks = Settings.oppositeChecks

                            local downAxis, releaseAxis = Config.downAxis, Config.releaseAxis

                            if Settings.autoAdjust then
                                local Values = fetchAutoAdjustValues(Settings.currentMeter)

                                if not Values then
                                    continue
                                end

                                barAxis, downAxis, releaseAxis = Values.barAxis, Values.downAxis, Values.releaseAxis
                                oppositeChecks = Values.oppositeChecks or false
                            end

                            local Axis = meterOffset and meterOffset[string.lower(barAxis)] or 0

                            if oppositeChecks and Axis <= downAxis or not oppositeChecks and Axis >= downAxis then
                                hasStartedLow = true
                            end

                            if (oppositeChecks and Axis >= releaseAxis or not oppositeChecks and Axis <= releaseAxis) and hasStartedLow then
                                canRelease = true
                            end
                        until canRelease == true

                        if shouldRelease then
                            keyrelease(Key)
                        end

                        Pressing = false
                    elseif Mode == "Timing" then
                        Pressing = true

                        keypress(Key)

                        task.wait(isJumping and Config.jumpTiming or Config.dunkTiming)

                        keyrelease(Key)

                        Pressing = false
                    end
                end
            end
        end 

        task.wait(1 / 10)
    end
end)


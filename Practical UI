-- // Auto Green Logic

--Works best with vertical meter, y values have to be adjusted for other meters
--The releaseY depends on your ping, suggested range is -1.3 to -1.45 which should be lowered with higher ping (example values, not tested: 20 ping -> -1.375, 50 ping -> -1.32)
--For controller support use ds4windows to remap square on ps5 or button x on xbox to the E key

--Keyboard: E/Space
--Controller: Square/Button X

--Hold the shooting input until the script releases for you for it to work

--Please read before asking any questions^^

if _G.autoGreenLoaded then
    return
end

print("Green running")

_G.autoGreenLoaded = true

_G.Settings = {
    Toggled = true,
    Mode = "Bar",
    Keybinds = {
        Jumpshot = "0x45",
        Dunking = "0x20"
    },
    Configs = {
        Bar = {
            downY = -1,
            releaseY = -1.375
        },
        Timing = {
            jumpTiming = 0.5,
            dunkTiming = 0.5
        }
    }
}

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Character = workspace:WaitForChild("Characters"):WaitForChild(LocalPlayer.Name)

local Pressing = false

task.spawn(function()
    while true do
        local Settings = _G.Settings

        if Settings.Toggled then
            local Keybinds = Settings.Keybinds
            local Mode = Settings.Mode
            local Config = Settings.Configs[Mode]

            local isJumping = iskeypressed(tonumber(Keybinds.Jumpshot))
            local isDunking = iskeypressed(tonumber(Keybinds.Dunking))

            if (isJumping or isDunking) and not Pressing then
                local Basketball = Character:FindFirstChild("Attributes") and Character.Attributes:FindFirstChild("Basketball")
                local hasBall = Basketball and Basketball.Value ~= nil

                if hasBall then
                    local Key = isJumping and Keybinds.Jumpshot or Keybinds.Dunking

                    if Mode == "Bar" then
                        Pressing = true
                        local hasStartedLow = false
                        local canRelease, shouldRelease = false, true

                        if not iskeypressed(Key) then
                            keypress(Key)
                        end
                        
                        repeat 
                            task.wait(1 / 60)
                            local ballAttr = Character:FindFirstChild("Attributes") and Character.Attributes:FindFirstChild("Basketball")
                            
                            if not (ballAttr and ballAttr.Value ~= nil) then
                                canRelease = true
                                shouldRelease = false
                                break
                            end

                            local meterOffset = Character:GetAttribute("meterOffset")
                            local Y = meterOffset and meterOffset.y or 0

                            if Y >= Config.downY then
                                hasStartedLow = true
                            end

                            if Y <= Config.releaseY and hasStartedLow then
                                canRelease = true
                            end
                        until canRelease == true

                        if shouldRelease then
                            keyrelease(Key)
                        end

                        Pressing = false
                    elseif Mode == "Timing" then
                        Pressing = true

                        keypress(Key)

                        task.wait(isJumping and Config.jumpTiming or Config.dunkTiming)

                        keyrelease(Key)

                        Pressing = false
                    end
                end
            end
        end 

        task.wait(1 / 30)
    end
end)


local lastAxis = 0
local lastTime = 0
local currentVelocity = 0

local SMOOTHING_FACTOR = 0.25
local MAX_DELTA_TIME = 0.2
local MAX_COMPENSATION = 50

function calculateDynamicCompensation(currentAxis, releaseAxis, oppositeChecks)
    local currentTime = os.clock()
    local deltaTime = currentTime - lastTime
    
    if deltaTime > 0 and deltaTime <= MAX_DELTA_TIME then
        local deltaAxis = currentAxis - lastAxis
        local instantaneousVelocity = deltaAxis / deltaTime
       
        currentVelocity = currentVelocity + (instantaneousVelocity - currentVelocity) * SMOOTHING_FACTOR
    elseif deltaTime > MAX_DELTA_TIME then
        currentVelocity = 0
    end
    
    lastAxis = currentAxis
    lastTime = currentTime

    local ping = GetPingValue() or 0
    local oneWayTrip = (ping / 1000) / 2

    local compensationDistance = currentVelocity * oneWayTrip

    if compensationDistance > MAX_COMPENSATION then
        compensationDistance = MAX_COMPENSATION
    elseif compensationDistance < -MAX_COMPENSATION then
        compensationDistance = -MAX_COMPENSATION
    end

    if oppositeChecks then
        return releaseAxis + compensationDistance
    else
        return releaseAxis - compensationDistance
    end
end

function fetchAutoAdjustValues(Meter)
    local Values = baseValues[Meter]

    if not Values then
        return nil
    end

    return {
        downAxis = Values.downAxis,
        releaseAxis = Values.releaseAxis,
        barAxis = Values.barAxis,
        oppositeChecks = Values.oppositeChecks or false
    }
end

local activeShooting = false
local activeKey = nil
local hasStartedLow = false
local shootingMode = nil
local shootStartTime = 0
local waitingForKeyRelease = false

_G.autoGreenConnection = RunService.RenderStepped:Connect(function()
    if not _G.autoGreenLoaded or not _G.Settings.Toggled then
        return 
    end
    
    local Character = workspace:FindFirstChild("Characters") and workspace.Characters:FindFirstChild(LocalPlayer.Name)

    if not Character then
        return
    end

    local Settings = _G.Settings
    local Keybinds = Settings.Keybinds
    local Mode = Settings.Mode
    local Config = Settings.Configs[Mode]

    local jumpKey = tonumber(Keybinds.Jumpshot)
    local dunkKey = tonumber(Keybinds.Dunking)
    
    local isJumping = iskeypressed(jumpKey)
    local isDunking = iskeypressed(dunkKey)

    if waitingForKeyRelease then
        if not isJumping and not isDunking then
            waitingForKeyRelease = false
        end

        return
    end

    local Basketball = Character:FindFirstChild("Attributes") and Character.Attributes:FindFirstChild("Basketball")
    local hasBall = Basketball and Basketball.Value ~= nil

    if not activeShooting then
        if (isJumping or isDunking) and hasBall then
            activeShooting = true
            activeKey = isJumping and jumpKey or dunkKey
            hasStartedLow = false
            shootingMode = Mode
            shootStartTime = os.clock()
            
            lastTime = shootStartTime
            currentVelocity = 0

            if not iskeypressed(activeKey) then
                keypress(activeKey)
            end
        end
    else
        if not hasBall then
            activeShooting = false
            waitingForKeyRelease = true
            keyrelease(activeKey)
            return
        end

        if shootingMode == "Bar" then
            local meterOffset = Character:GetAttribute("meterOffset")
            
            if not meterOffset then return end 
            
            local barAxis = Settings.barAxis
            local oppositeChecks = Settings.oppositeChecks
            local downAxis = Settings.Configs.Bar.downAxis
            local rawReleaseAxis = Settings.Configs.Bar.releaseAxis

            if Settings.autoAdjust then
                local Values = fetchAutoAdjustValues(Settings.currentMeter)

                if Values then
                    barAxis = Values.barAxis
                    downAxis = Values.downAxis
                    rawReleaseAxis = Values.releaseAxis
                    oppositeChecks = Values.oppositeChecks
                end
            end

            local Axis = meterOffset[string.lower(barAxis)] or 0
            
            -- // dynamic composition made by ai, works well

            local compensatedReleaseAxis = calculateDynamicCompensation(Axis, rawReleaseAxis, oppositeChecks)

            if (oppositeChecks and Axis <= downAxis) or (not oppositeChecks and Axis >= downAxis) then
                hasStartedLow = true
            end

            if hasStartedLow then
                local shouldRelease = (oppositeChecks and Axis >= compensatedReleaseAxis) or (not oppositeChecks and Axis <= compensatedReleaseAxis)
                if shouldRelease then
                    keyrelease(activeKey)
                    activeShooting = false
                    waitingForKeyRelease = true
                end
            end

        elseif shootingMode == "Timing" then
            local targetTime = (activeKey == jumpKey) and Config.jumpTiming or Config.dunkTiming
            
            if os.clock() - shootStartTime >= targetTime then
                keyrelease(activeKey)
                activeShooting = false
                waitingForKeyRelease = true
            end
        end
    end
end)


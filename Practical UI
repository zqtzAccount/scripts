function getKeyCodeHex(keyName)
    if not keyName then return "0x45" end
    
    local upperKey = string.upper(keyName)

    if upperKey == "SPACE" then
        return "0x20"
    elseif upperKey == "BACKQUOTE" or upperKey == "`" then
        return "0xC0"
    end

    if #keyName == 1 then
        return string.format("0x%X", string.byte(upperKey))
    end
    
    return "0x45"
end

